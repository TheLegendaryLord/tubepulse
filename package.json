{
  "name": "tubepulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local YouTube Rich Presence for Discord Desktop",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "package:windows": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Package-Windows.ps1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
