{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "TubePulse",
  "description": "Share your YouTube playback with Discord, on your terms.",
  "version": "0.1.1",
  "permissions": ["storage", "nativeMessaging"],
  "icons": {
    "16": "icons/pulse-16.png",
    "32": "icons/pulse-32.png",
    "48": "icons/pulse-48.png",
    "128": "icons/pulse-128.png"
  },
  "action": {
    "default_title": "TubePulse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pulse-16.png",
      "32": "icons/pulse-32.png",
      "48": "icons/pulse-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed"
}
